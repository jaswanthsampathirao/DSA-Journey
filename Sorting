class Solution {
public:
    vector<int> selectionSort(vector<int>& arr) {
 int n= arr.size();
 int i,j;
 for (i=0;i<n-1;i++){
    int min=arr[i];
    for(j=i+1;j<n;j++){
        if(arr[j]<min){
            min=arr[j];
        }

    }
    if(min!=arr[i]){
        int temp=arr[i];
        arr[i]=min;
        min=temp;

    }
 }
 return arr;
    }
};
